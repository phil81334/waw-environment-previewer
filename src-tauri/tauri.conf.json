{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "World at War Environment Previewer",
  "version": "0.2.0",
  "identifier": "com.phil81334.waw-environment-previewer",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1443",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "World at War Environment Previewer",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "backgroundColor": "#191e23"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1443; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
